From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Sun, 1 Nov 2026 03:25:30 +0000
Subject: [PATCH] vulkan: gated delta net loads the next token's inputs during
 the current one

---
 .../vulkan-shaders/gated_delta_net.comp       | 61 ++++++++++++++-----
 1 file changed, 46 insertions(+), 15 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
index 0e384330b..cb9a7352e 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
@@ -92,6 +92,31 @@ FLOAT_TYPE reduce_partial(FLOAT_TYPE partial) {
     }
 }
 
+void load_token(uint t, uint iq1, uint iq3, uint seq_id, uint head_id, uint lane, uint col,
+                inout FLOAT_TYPE k_r[ROWS_PER_LANE], inout FLOAT_TYPE q_r[ROWS_PER_LANE], inout FLOAT_TYPE g_r[ROWS_PER_LANE],
+                inout FLOAT_TYPE beta_r, inout FLOAT_TYPE v_r) {
+    const uint q_off = iq3 * sq3 + t * sq2 + iq1 * sq1;
+    const uint v_off = seq_id * sv3 + t * sv2 + head_id * sv1;
+    const uint gb_off = seq_id * sb3 + t * sb2 + head_id * sb1;
+    [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
+        const uint i = r * LANES_PER_COLUMN + lane;
+        k_r[r] = FLOAT_TYPE(data_k[q_off + i]);
+        q_r[r] = FLOAT_TYPE(data_q[q_off + i]);
+    }
+    if (KDA == 0) {
+        const FLOAT_TYPE g = FLOAT_TYPE(data_g[gb_off]);
+        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
+            g_r[r] = g;
+        }
+    } else {
+        [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
+            g_r[r] = FLOAT_TYPE(data_g[gb_off * S_V + r * LANES_PER_COLUMN + lane]);
+        }
+    }
+    beta_r = FLOAT_TYPE(data_beta[gb_off]);
+    v_r = FLOAT_TYPE(data_v[v_off + col]);
+}
+
 void main() {
     const uint head_id = gl_WorkGroupID.x;
     const uint seq_id = gl_WorkGroupID.y;
@@ -118,37 +143,43 @@ void main() {
 
     uint attn_off = (seq_id * n_tokens * H + head_id) * S_V;
 
-    for (uint t = 0; t < n_tokens; t++) {
-        const uint q_off = iq3 * sq3 + t * sq2 + iq1 * sq1;
-        const uint k_off = q_off;
-        const uint v_off = seq_id * sv3 + t * sv2 + head_id * sv1;
-        const uint gb_off = seq_id * sb3 + t * sb2 + head_id * sb1;
-        const FLOAT_TYPE beta_val = FLOAT_TYPE(data_beta[gb_off]);
+    // The inputs of token t + 1 are loaded while token t is computed, so the loop does not wait on a load each token.
+    FLOAT_TYPE k_next[ROWS_PER_LANE];
+    FLOAT_TYPE q_next[ROWS_PER_LANE];
+    FLOAT_TYPE g_next[ROWS_PER_LANE];
+    FLOAT_TYPE beta_next = FLOAT_TYPE(0);
+    FLOAT_TYPE v_next = FLOAT_TYPE(0);
+    if (n_tokens > 0) {
+        load_token(0, iq1, iq3, seq_id, head_id, lane, col, k_next, q_next, g_next, beta_next, v_next);
+    }
 
+    for (uint t = 0; t < n_tokens; t++) {
         FLOAT_TYPE k_reg[ROWS_PER_LANE];
         FLOAT_TYPE q_reg[ROWS_PER_LANE];
+        FLOAT_TYPE g_raw[ROWS_PER_LANE];
         [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
-            const uint i = r * LANES_PER_COLUMN + lane;
-            k_reg[r] = FLOAT_TYPE(data_k[k_off + i]);
-            q_reg[r] = FLOAT_TYPE(data_q[q_off + i]);
+            k_reg[r] = k_next[r];
+            q_reg[r] = q_next[r];
+            g_raw[r] = g_next[r];
+        }
+        const FLOAT_TYPE beta_val = beta_next;
+        const FLOAT_TYPE v_val = v_next;
+        if (t + 1 < n_tokens) {
+            load_token(t + 1, iq1, iq3, seq_id, head_id, lane, col, k_next, q_next, g_next, beta_next, v_next);
         }
 
         FLOAT_TYPE g_exp[ROWS_PER_LANE];
         if (KDA == 0) {
-            const FLOAT_TYPE g_val = exp(FLOAT_TYPE(data_g[gb_off]));
+            const FLOAT_TYPE g_val = exp(g_raw[0]);
             [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
                 g_exp[r] = g_val;
             }
         } else {
-            const uint g_base = gb_off * S_V;
             [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
-                const uint i = r * LANES_PER_COLUMN + lane;
-                g_exp[r] = exp(FLOAT_TYPE(data_g[g_base + i]));
+                g_exp[r] = exp(g_raw[r]);
             }
         }
 
-        const FLOAT_TYPE v_val = FLOAT_TYPE(data_v[v_off + col]);
-
         FLOAT_TYPE kv_shard = 0.0;
         [[unroll]] for (uint r = 0; r < ROWS_PER_LANE; r++) {
             kv_shard += g_exp[r] * s_shard[r] * k_reg[r];
-- 
2.43.0

