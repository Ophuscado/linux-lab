#version 450
// The matrix-vector's access pattern without its arithmetic: each workgroup sums its own contiguous slice of the
// buffer (n / groups floats, as a workgroup reads its rows), its threads striding inside the slice, where read.comp
// interleaves all workgroups over the whole buffer.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer B { vec4 v[]; };
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint nv = p.n / 4, slice = nv / gl_NumWorkGroups.x, base = gl_WorkGroupID.x * slice;
    vec4 s = vec4(0.0);
    for (uint i = gl_LocalInvocationID.x; i < slice; i += 256u) s += v[base + i];
    if (s.x == 1.2345e-37) v[0] = s;
}
