#version 450
// One small step, as a decode step of an LLM is: read a vector, write it back.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer B { float x[]; };
layout(constant_id = 7) const uint VARIANT = 0;
layout(push_constant) uniform P { uint n; } p;
void main() { uint i = gl_GlobalInvocationID.x; if (i < p.n) x[i] = x[i] * 1.0001 + 1.0; }
