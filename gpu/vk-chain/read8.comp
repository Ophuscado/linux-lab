#version 450
// read.comp with 8-byte loads (uvec2) instead of 16: whether the load width alone limits a grid-stride read.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer B { uvec2 v[]; };
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint nv = p.n / 2, stride = gl_NumWorkGroups.x * 256u;
    uvec2 s = uvec2(0);
    for (uint i = gl_GlobalInvocationID.x; i < nv; i += stride) s += v[i];
    if (s == uvec2(0x9e3779b9u)) v[0] = s;
}
