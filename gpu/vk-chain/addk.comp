#version 450
// The plain add as a grid-stride loop, so the same bytes can be spread over few or many workgroups
// (VKCHAIN_GROUPS): does a launch's latency depend on how many workgroups it starts?
layout(local_size_x = 256) in;
layout(constant_id = 0) const uint MODE = 0;
layout(constant_id = 1) const uint ITERS = 0;
layout(constant_id = 7) const uint VARIANT = 0;
layout(std430, binding = 0) buffer B { float x[]; };
layout(push_constant) uniform P { uint n; } p;
void main() {
    uint stride = gl_NumWorkGroups.x * 256;
    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride) x[i] = x[i] * 1.0001 + 1.0;
}
