diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_ext.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_ext.comp
new file mode 100644
index 000000000..ee6cc1223
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_ext.comp
@@ -0,0 +1,90 @@
+#version 450
+
+// q4_0 and q8_0 times 2-16 columns of B, laid out like ggml-metal's kernel_mul_mv_ext: a row is split over only
+// NXPSG invocations, so a subgroup takes 32/NXPSG rows and a workgroup NUM_ROWS of them; every invocation keeps one
+// row's partial sums for all NUM_COLS columns. The rows of a workgroup read the same B at the same time, so B comes
+// from cache once per workgroup instead of once per one or two rows. Same interface as mul_mat_vec.comp, without
+// MUL_MAT_ID; the host dispatches it with NUM_ROWS rows a workgroup.
+
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+#extension GL_KHR_shader_subgroup_basic : require
+#extension GL_KHR_shader_subgroup_clustered : require
+
+#include "mul_mat_vec_base.glsl"
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+#define NXPSG 8 // invocations along a row
+#define CHPT 4  // 4-value chunks an invocation takes per step
+
+// The 4 values 4c..4c+3 of block blk (c in 0..7).
+vec4 dequant4(const uint blk, const uint c) {
+#if defined(DATA_A_Q8_0)
+    const int w0 = int(data_a_packed16[blk].qs[2*c]);
+    const int w1 = int(data_a_packed16[blk].qs[2*c + 1]);
+    return vec4((w0 << 24) >> 24, w0 >> 8, (w1 << 24) >> 24, w1 >> 8) * float(data_a_packed16[blk].d);
+#elif defined(DATA_A_Q4_0)
+    // Bytes 0-15 hold values 0-15 in their low nibbles and 16-31 in their high ones.
+    const uint b = (c & 3u) * 4u;
+    const uint w0 = uint(data_a_packed16[blk].qs[b/2]);
+    const uint w1 = uint(data_a_packed16[blk].qs[b/2 + 1]);
+    const uint sh = c < 4u ? 0u : 4u;
+    const vec4 q = vec4((w0 >> sh) & 0xFu, (w0 >> (8u + sh)) & 0xFu, (w1 >> sh) & 0xFu, (w1 >> (8u + sh)) & 0xFu);
+    return (q - 8.0f) * float(data_a_packed16[blk].d);
+#else
+#error "mul_mat_vec_ext.comp: q4_0 and q8_0 only"
+#endif
+}
+
+void main() {
+    const uint lane = gl_SubgroupInvocationID;
+    const uint tx = lane % NXPSG;
+    const uint ty = lane / NXPSG;
+    const uint row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z)
+                   + (32 / NXPSG) * gl_SubgroupID + ty;
+    const bool valid = row < p.stride_d;
+
+    uint a_offset, b_offset, d_offset;
+    get_offsets(a_offset, b_offset, d_offset);
+
+    const uint nb = p.ncols / QUANT_K;
+    const uint ablk = a_offset + (valid ? row : 0) * nb;
+    const uint nchunks = p.ncols / 4;
+
+    float sums[NUM_COLS];
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        sums[j] = 0.0f;
+    }
+
+    for (uint ich = tx; ich < nchunks; ich += CHPT * NXPSG) {
+        vec4 lx[CHPT];
+        [[unroll]] for (uint ch = 0; ch < CHPT; ++ch) {
+            const uint c = ich + ch * NXPSG;
+            lx[ch] = c < nchunks ? dequant4(ablk + c / 8u, c % 8u) : vec4(0.0f);
+        }
+        [[unroll]] for (uint ch = 0; ch < CHPT; ++ch) {
+            const uint c = min(ich + ch * NXPSG, nchunks - 1);
+            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+                sums[j] += dot(lx[ch], vec4(data_b_v4[(j*p.batch_stride_b + b_offset) / 4 + c]));
+            }
+        }
+    }
+
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        sums[j] = subgroupClusteredAdd(sums[j], NXPSG);
+    }
+
+    if (tx == 0 && valid) {
+        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+            float r = sums[j];
+            if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS0) != 0) {
+                r += float(data_fuse0[j*p.batch_stride_d + d_offset + row]);
+            }
+            if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_BIAS1) != 0) {
+                r += float(data_fuse1[j*p.batch_stride_d + d_offset + row]);
+            }
+            data_d[j*p.batch_stride_d + d_offset + row] = D_TYPE(r);
+        }
+    }
+}
