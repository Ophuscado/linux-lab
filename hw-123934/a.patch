From 754932c83bbca66a4104e392a86f9d57c09fefa9 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Sun, 1 Nov 2026 12:39:17 +0000
Subject: [PATCH] agx: hoist window settable (AGX_HOIST_WINDOW)

---
 src/asahi/compiler/agx_pressure_schedule.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/src/asahi/compiler/agx_pressure_schedule.c b/src/asahi/compiler/agx_pressure_schedule.c
index 57bfb17..74b98b2 100644
--- a/src/asahi/compiler/agx_pressure_schedule.c
+++ b/src/asahi/compiler/agx_pressure_schedule.c
@@ -6,6 +6,7 @@
 
 /* Bottom-up local scheduler to reduce register pressure */
 
+#include <stdlib.h>
 #include "util/dag.h"
 #include "util/sparse_bitset.h"
 #include "agx_compiler.h"
@@ -279,7 +280,15 @@ agx_pressure_schedule(agx_context *ctx)
  * order device memory: device stores, atomics, memory barriers, coherent
  * loads, image ops, control flow.
  */
-#define HOIST_WINDOW 64
+#define HOIST_WINDOW_DEFAULT 64
+
+/* AGX_HOIST_WINDOW sets the window (tuning). */
+static unsigned
+hoist_window(void)
+{
+   const char *env = getenv("AGX_HOIST_WINDOW");
+   return env ? (unsigned)atoi(env) : HOIST_WINDOW_DEFAULT;
+}
 
 /*
  * A uniform_store writes at most four 16-bit uniform registers starting at its
@@ -334,6 +343,8 @@ hoist_can_cross(const agx_instr *P, const agx_instr *load)
 void
 agx_hoist_loads(agx_context *ctx)
 {
+   const unsigned window = hoist_window();
+
    agx_foreach_block(ctx, block) {
       agx_foreach_instr_in_block_safe(block, I) {
          if (instr_after_logical_end(I))
@@ -346,7 +357,7 @@ agx_hoist_loads(agx_context *ctx)
          unsigned n = 0;
 
          for (agx_instr *P = list_entry(I->link.prev, agx_instr, link);
-              &P->link != &block->instructions && n < HOIST_WINDOW;
+              &P->link != &block->instructions && n < window;
               P = list_entry(P->link.prev, agx_instr, link), ++n) {
 
             if (!hoist_can_cross(P, I))
-- 
2.43.0

