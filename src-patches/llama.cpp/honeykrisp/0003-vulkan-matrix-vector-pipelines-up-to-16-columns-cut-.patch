From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Mon, 26 Oct 2026 23:40:38 +0000
Subject: [PATCH 3/11] vulkan: matrix-vector pipelines up to 16 columns, cut
 settable

Dense MUL_MAT leaves the matrix-vector shader past mul_mat_vec_max_cols, a compile-time 8, and a 9-token batch then runs at a fraction of an 8-token one. Pipelines now exist for up to 16 columns (compiled on first use) and GGML_VK_MMV_MAX_COLS (default 8, at most 16) sets the cut used.

On an M2 Ultra at 16, t/s for a 9-token batch: Qwen3-Coder-Next Q8 37 -> 107, Gemma 4 26B-A4B Q4_K 45 -> 138, Llama 2 7B Q4_0 42 -> 168 (8 tokens: 106, 137, 171). MUL_MAT 2275/2275 pass with every case up to 16 columns on the matrix-vector path. The cliff moves to 17 tokens.
---
 ggml/src/ggml-vulkan/ggml-vulkan-types.h | 13 ++++++++++++-
 ggml/src/ggml-vulkan/ggml-vulkan.cpp     |  6 +++---
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan-types.h b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
index 5cf46c890..88d0f3a37 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan-types.h
+++ b/ggml/src/ggml-vulkan/ggml-vulkan-types.h
@@ -49,6 +49,7 @@ typedef struct VkPhysicalDeviceCooperativeMatrixDecodeVectorFeaturesNV {
 
 #include <algorithm>
 #include <cmath>
+#include <cstdlib>
 #include <functional>
 #include <iomanip>
 #include <iostream>
@@ -359,7 +360,17 @@ struct vk_queue {
     bool transfer_only;
 };
 
-static constexpr uint32_t mul_mat_vec_max_cols = 8;
+// Pipelines exist for up to this many columns (compiled when first used); ggml_vk_mmv_max_cols() is the cut used.
+static constexpr uint32_t mul_mat_vec_max_cols = 16;
+// Tuning: GGML_VK_MMV_MAX_COLS, the most columns a MUL_MAT takes the matrix-vector path for (default 8, at most 16).
+static inline uint32_t ggml_vk_mmv_max_cols() {
+    static const uint32_t v = [] {
+        const char * e = getenv("GGML_VK_MMV_MAX_COLS");
+        const unsigned long n = e ? strtoul(e, nullptr, 10) : 8ul;
+        return (uint32_t)(n < 1 ? 1 : n > mul_mat_vec_max_cols ? mul_mat_vec_max_cols : n);
+    }();
+    return v;
+}
 
 static constexpr uint32_t p021_max_gqa_ratio = 8;
 
diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 768af5419..54b09ff96 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -7459,7 +7459,7 @@ void ggml_vk_mul_mat(ggml_backend_vk_context * ctx, vk_context& subctx, const st
     } else if (ctx->num_additional_fused_ops == 0 &&
                (src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16) &&
                (src1->type == GGML_TYPE_F32 || src1->type == GGML_TYPE_F16 || src1->type == GGML_TYPE_BF16 || ggml_is_quantized(src1->type)) &&
-               dst->ne[0] == 1 && dst->ne[1] > mul_mat_vec_max_cols &&
+               dst->ne[0] == 1 && dst->ne[1] > ggml_vk_mmv_max_cols() &&
                src0->ne[2] == 1 && src0->ne[3] == 1 &&
                src1->ne[2] == 1 && src1->ne[3] == 1 &&
                ggml_is_contiguous(src0) && ggml_is_contiguous(src1) && ggml_is_contiguous(dst) &&
@@ -7467,7 +7467,7 @@ void ggml_vk_mul_mat(ggml_backend_vk_context * ctx, vk_context& subctx, const st
         ggml_vk_mul_mat_vec_q_f16(ctx, subctx, cgraph, node_idx, true);
     // mul_mat_vec supports batching ne12*ne13 when ne11==1, or treating ne11 as the batch size (up to four)
     // when ne12 and ne13 are one.
-    } else if ((dst->ne[1] == 1 || (dst->ne[1] <= mul_mat_vec_max_cols && src1->ne[2] * src1->ne[3] == 1)) &&
+    } else if ((dst->ne[1] == 1 || (dst->ne[1] <= ggml_vk_mmv_max_cols() && src1->ne[2] * src1->ne[3] == 1)) &&
                (src0->type == GGML_TYPE_F32 || src0->type == GGML_TYPE_F16 || src0->type == GGML_TYPE_BF16 || ggml_is_quantized(src0->type))) {
         ggml_vk_mul_mat_vec_q_f16(ctx, subctx, cgraph, node_idx);
     } else {
@@ -16734,7 +16734,7 @@ std::string vk_perf_logger::get_node_fusion_name(const ggml_tensor * node, const
         const uint64_t k     = node->src[1]->ne[0];
         const uint64_t batch = node->ne[2] * node->ne[3];
         std::string    name  = ggml_op_name(node->op);
-        if ((node->op == GGML_OP_MUL_MAT && n <= mul_mat_vec_max_cols) ||
+        if ((node->op == GGML_OP_MUL_MAT && n <= ggml_vk_mmv_max_cols()) ||
             (node->op == GGML_OP_MUL_MAT_ID && node->src[2]->ne[1] == 1)) {
             name += "_VEC";
         }
