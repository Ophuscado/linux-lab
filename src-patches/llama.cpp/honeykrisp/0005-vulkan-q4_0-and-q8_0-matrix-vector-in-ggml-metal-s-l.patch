diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_simd.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_simd.comp
new file mode 100644
index 000000000..585e11d7c
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_mat_vec_simd.comp
@@ -0,0 +1,107 @@
+#version 450
+
+// Matrix-vector product for q4_0 and q8_0 laid out the way ggml-metal's kernel_mul_mv_q4_0/q8_0 are:
+// each invocation takes a fixed slice of a block (half a q4_0 block, a quarter of a q8_0 block), keeps its
+// part of B in registers and applies it to every row of the workgroup, so one load of B serves NUM_ROWS rows.
+// For q4_0, B is prescaled by 1, 1/256, 1/16 and 1/4096 so that the quants are only masked, never shifted,
+// and the -8 offset is applied once per block through the sum of B. Same interface as mul_mat_vec.comp.
+
+#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
+
+#include "mul_mat_vec_base.glsl"
+
+layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
+
+#if defined(DATA_A_Q4_0)
+#define SLICES 2    // invocations per block
+#elif defined(DATA_A_Q8_0)
+#define SLICES 4
+#else
+#error "mul_mat_vec_simd.comp: q4_0 and q8_0 only"
+#endif
+
+void compute_outputs(const uint first_row, const uint num_rows) {
+    const uint tid = gl_LocalInvocationID.x;
+
+    uint a_offset, b_offset, d_offset;
+    get_offsets(a_offset, b_offset, d_offset);
+
+    float acc[NUM_COLS][NUM_ROWS];
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+            acc[j][n] = 0.0f;
+        }
+    }
+
+    const uint nb = p.ncols / QUANT_K;
+    const uint ix = tid / SLICES;           // first block of this invocation
+    const uint il = (tid % SLICES) * 8;     // q4_0: first of 8 low-nibble values; q8_0: first of 8 values
+    const uint step = BLOCK_SIZE / SLICES;  // blocks covered by the workgroup per iteration
+
+    for (uint ib = ix; ib < nb; ib += step) {
+        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+            // Rows of B are aligned to 4 elements here, as mul_mat_vec.comp's vec4 loads assume too.
+            const uint yv = (j*p.batch_stride_b + b_offset + ib*QUANT_K + il) / 4;
+#if defined(DATA_A_Q4_0)
+            // Byte k of the slice holds value il+k (low nibble) and il+k+16 (high nibble); a 16-bit word holds
+            // bytes 2m and 2m+1, so its masks 0x000F, 0x0F00, 0x00F0, 0xF000 give values 2m, 2m+1, 2m+16, 2m+17
+            // times 1, 256, 16 and 4096.
+            const vec4 y0 = vec4(data_b_v4[yv]);
+            const vec4 y1 = vec4(data_b_v4[yv + 1]);
+            const vec4 y2 = vec4(data_b_v4[yv + 4]);
+            const vec4 y3 = vec4(data_b_v4[yv + 5]);
+            const float sumy = dot(y0 + y1 + y2 + y3, vec4(1.0f));
+            const vec4 ya = vec4(y0.x, y0.z, y1.x, y1.z);
+            const vec4 yb = vec4(y0.y, y0.w, y1.y, y1.w) * (1.0f/256.0f);
+            const vec4 yc = vec4(y2.x, y2.z, y3.x, y3.z) * (1.0f/16.0f);
+            const vec4 yd = vec4(y2.y, y2.w, y3.y, y3.w) * (1.0f/4096.0f);
+
+            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+                if (n >= num_rows) break;
+                const uint blk = a_offset + (first_row + n)*nb + ib;
+                const uvec4 q = uvec4(data_a_packed16[blk].qs[il/2 + 0], data_a_packed16[blk].qs[il/2 + 1],
+                                      data_a_packed16[blk].qs[il/2 + 2], data_a_packed16[blk].qs[il/2 + 3]);
+                const float s = dot(ya, vec4(q & 0x000Fu)) + dot(yb, vec4(q & 0x0F00u))
+                              + dot(yc, vec4(q & 0x00F0u)) + dot(yd, vec4(q & 0xF000u));
+                acc[j][n] += float(data_a_packed16[blk].d) * (s - 8.0f*sumy);
+            }
+#else
+            const vec4 y0 = vec4(data_b_v4[yv]);
+            const vec4 y1 = vec4(data_b_v4[yv + 1]);
+
+            [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+                if (n >= num_rows) break;
+                const uint blk = a_offset + (first_row + n)*nb + ib;
+                const ivec4 w = ivec4(data_a_packed16[blk].qs[il/2 + 0], data_a_packed16[blk].qs[il/2 + 1],
+                                      data_a_packed16[blk].qs[il/2 + 2], data_a_packed16[blk].qs[il/2 + 3]);
+                const ivec4 lo = (w << 24) >> 24;
+                const ivec4 hi = w >> 8;
+                const float s = dot(vec4(lo.x, hi.x, lo.y, hi.y), y0) + dot(vec4(lo.z, hi.z, lo.w, hi.w), y1);
+                acc[j][n] += float(data_a_packed16[blk].d) * s;
+            }
+#endif
+        }
+    }
+
+    FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];
+    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
+        [[unroll]] for (uint n = 0; n < NUM_ROWS; ++n) {
+            temp[j][n] = FLOAT_TYPE(acc[j][n]);
+        }
+    }
+    reduce_result(temp, d_offset, first_row, num_rows, tid);
+}
+
+void main() {
+    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
+
+    if (first_row + NUM_ROWS <= p.stride_d) {
+        compute_outputs(first_row, NUM_ROWS);
+    } else {
+        if (first_row >= p.stride_d) {
+            return;
+        }
+        compute_outputs(first_row, min(NUM_ROWS, p.stride_d - first_row));
+    }
+}
