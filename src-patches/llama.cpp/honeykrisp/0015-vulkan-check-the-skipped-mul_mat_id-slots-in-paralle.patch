From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Sun, 1 Nov 2026 02:47:24 +0000
Subject: [PATCH 15/16] vulkan: check the skipped mul_mat_id slots in parallel

count_experts runs as one workgroup before every MUL_MAT_ID, and its zero_skipped_rows had each of its 256 invocations walk all n_used x n_tokens ids, so a Qwen 3.x prompt of 512 tokens (512 experts, 10 used) did 5120 loads one after another in every invocation before the matmul could start. Each invocation now checks only its own slots and zeroes a skipped row alone; skipped slots (-1 ids) are rare.
---
 ggml/src/ggml-vulkan/vulkan-shaders/count_experts.comp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/count_experts.comp b/ggml/src/ggml-vulkan/vulkan-shaders/count_experts.comp
index a46a06193..9a76390a0 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/count_experts.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/count_experts.comp
@@ -56,7 +56,8 @@ void zero_skipped_rows() {
     const uint num_elements = p.ne00 * p.ne01;
     const uint tid = gl_LocalInvocationID.x;
 
-    for (uint idx = 0; idx < num_elements; idx++) {
+    // Each invocation checks its own slots: every invocation walking every slot serialized thousands of loads
+    for (uint idx = tid; idx < num_elements; idx += BLOCK_SIZE) {
         const uint i01 = fastdiv(idx, p.ne00mp, p.ne00L);
         const uint i00 = idx - i01 * p.ne00;
 
@@ -65,7 +66,7 @@ void zero_skipped_rows() {
         }
 
         const uint d_off = i00 * p.stride_dst + i01 * p.batch_stride_dst;
-        for (uint i = tid; i < p.ne0_dst; i += BLOCK_SIZE) {
+        for (uint i = 0; i < p.ne0_dst; i++) {
             data_dst[d_off + i] = 0.0f;
         }
     }
