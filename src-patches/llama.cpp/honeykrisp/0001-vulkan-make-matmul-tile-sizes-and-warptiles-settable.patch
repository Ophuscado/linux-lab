From: Ophuscado <postbox@ophuscado.com>
Date: Mon, 26 Oct 2026 23:40:38 +0000
Subject: [PATCH 1/14] vulkan: make matmul tile sizes and warptiles settable on
 Honeykrisp

Honeykrisp (Asahi Linux) is built with the medium matmul tile only, the choice made for MoltenVK. GGML_VK_MM_SIZES and GGML_VK_MMID_SIZES pick the sizes built (letters of "sml", default m), and GGML_VK_WT_S/M/L replace fields of a size's warptiles ("BLOCK,BM,BN,BK,WM,WN,WMITER,TM,TN,TK,WARP", empty fields kept; the workgroup denominators follow BM and BN). GGML_VK_TILES_PRINT=1 prints what was built.

On an M2 Ultra (76-core G14D, Mesa with the coopmat series) the medium tile at 256 threads, 128x64 (GGML_VK_WT_M=256,128,64,,32,32) gives prompts +12-23%: Qwen3-Coder-Next Q8 pp512 434 -> 488, pp2048 672 -> 780; Llama 2 7B Q4_0 pp512 620 -> 762; Gemma 4 26B-A4B Q4_K pp2048 770 -> 905. Generation is unchanged. MUL_MAT 555/555 and MUL_MAT_ID 591/591 pass with every setting kept; BK 16 fails quantized MUL_MAT and is not a candidate.
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 93 ++++++++++++++++++++++++++--
 1 file changed, 87 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 33936acae..d87069212 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -1874,6 +1874,64 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
             }
         }
 
+        // Tuning: GGML_VK_WT_S, GGML_VK_WT_M, GGML_VK_WT_L replace fields of that size's warptiles,
+        // "BLOCK,BM,BN,BK,WM,WN,WMITER,TM,TN,TK,WARP", an empty field keeps its value. BLOCK..WMITER go to every
+        // family, TM..WARP only to the float and coopmat ones (the integer ones hold their own TM, TN, TK); the
+        // workgroup denominators follow BM and BN.
+        [[maybe_unused]] const auto wt_override = [](const char * name, std::initializer_list<std::vector<uint32_t> *> all,
+                                    std::initializer_list<std::vector<uint32_t> *> fl,
+                                    std::initializer_list<std::array<uint32_t, 3> *> denoms) {
+            const char * s = getenv(name);
+            if (!s) {
+                return;
+            }
+            std::vector<std::pair<size_t, uint32_t>> set;
+            size_t k = 0;
+            for (const char * p = s; ; k++) {
+                char * e;
+                const unsigned long v = strtoul(p, &e, 10);
+                if (e != p) {
+                    set.emplace_back(k, (uint32_t)v);
+                }
+                p = strchr(p, ',');
+                if (!p) {
+                    break;
+                }
+                p++;
+            }
+            for (auto [i, v] : set) {
+                for (auto * w : (i < 7 ? all : fl)) {
+                    if (i < w->size()) {
+                        (*w)[i] = v;
+                    }
+                }
+                if (i == 1 || i == 2) {
+                    for (auto * d : denoms) {
+                        (*d)[i - 1] = v;
+                    }
+                }
+            }
+        };
+#if VK_HEADER_VERSION >= 287
+        if (device->driver_id == vk::DriverId::eMesaHoneykrisp) {
+            wt_override("GGML_VK_WT_S",
+                { &s_warptile, &s_warptile_mmq, &s_warptile_mmq_int, &s_warptile_mmq_int_k,
+                  &s_warptile_id, &s_warptile_mmqid, &s_warptile_mmqid_int, &s_warptile_mmqid_int_k },
+                { &s_warptile, &s_warptile_mmq, &s_warptile_id, &s_warptile_mmqid },
+                { &s_wg_denoms, &s_mmq_wg_denoms });
+            wt_override("GGML_VK_WT_M",
+                { &m_warptile, &m_warptile_mmq, &m_warptile_mmq_int, &m_warptile_mmq_int_k,
+                  &m_warptile_id, &m_warptile_mmqid, &m_warptile_mmqid_int, &m_warptile_mmqid_int_k },
+                { &m_warptile, &m_warptile_mmq, &m_warptile_id, &m_warptile_mmqid },
+                { &m_wg_denoms, &m_mmq_wg_denoms });
+            wt_override("GGML_VK_WT_L",
+                { &l_warptile, &l_warptile_mmq, &l_warptile_mmq_int, &l_warptile_mmq_int_k,
+                  &l_warptile_id, &l_warptile_mmqid, &l_warptile_mmqid_int, &l_warptile_mmqid_int_k },
+                { &l_warptile, &l_warptile_mmq, &l_warptile_id, &l_warptile_mmqid },
+                { &l_wg_denoms, &l_mmq_wg_denoms });
+        }
+#endif
+
         const bool use_cm1_int = device->coopmat_int_support &&
                                  (device->architecture == AMD_RDNA3 || device->architecture == AMD_RDNA4);
 
@@ -2262,6 +2320,23 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
         return result;
     };
 
+    if (getenv("GGML_VK_TILES_PRINT")) {
+        const auto pw = [](const char * n, const std::vector<uint32_t> & w) {
+            std::cerr << " " << n << "=";
+            for (size_t i = 0; i < w.size(); i++) {
+                std::cerr << (i ? "," : "") << w[i];
+            }
+        };
+        std::cerr << "ggml_vulkan: tiles";
+        pw("s", s_warptile_mmq); pw("m", m_warptile_mmq); pw("l", l_warptile_mmq);
+        std::cerr << std::endl;
+        for (ggml_type t : { GGML_TYPE_F16, GGML_TYPE_Q4_0, GGML_TYPE_Q8_0, GGML_TYPE_Q4_K }) {
+            std::cerr << "ggml_vulkan: " << ggml_type_name(t) << " mm s/m/l " << device->mul_mat_s[t] << device->mul_mat_m[t]
+                      << device->mul_mat_l[t] << ", id " << device->mul_mat_id_s[t] << device->mul_mat_id_m[t]
+                      << device->mul_mat_id_l[t] << std::endl;
+        }
+    }
+
     std::vector<vk_tile_config> tc_mm = {{s_warptile, s_wg_denoms, s_align}, {m_warptile, m_wg_denoms, m_align}, {l_warptile, l_wg_denoms, l_align}};
     std::vector<vk_tile_config> tc_mmq = {{s_warptile_mmq, s_mmq_wg_denoms, s_align}, {m_warptile_mmq, m_mmq_wg_denoms, m_align}, {l_warptile_mmq, l_mmq_wg_denoms, l_align}};
 
@@ -4849,12 +4924,18 @@ vk_device ggml_vk_get_device(size_t idx) {
             // Honeykrisp driver for Asahi Linux doesn't report VK_VENDOR_ID_APPLE.
             // Check for Honeykrisp driver and force same configuration as the VK_VENDOR_ID_APPLE case.
             if (device->driver_id == vk::DriverId::eMesaHoneykrisp) {
-                device->mul_mat_l[i] = false;
-                device->mul_mat_m[i] = true;
-                device->mul_mat_s[i] = false;
-                device->mul_mat_id_l[i] = false;
-                device->mul_mat_id_m[i] = true;
-                device->mul_mat_id_s[i] = false;
+                // Tuning: GGML_VK_MM_SIZES and GGML_VK_MMID_SIZES, the tile sizes built, letters of "sml"
+                // (default m; MMID follows MM)
+                const char * mm = getenv("GGML_VK_MM_SIZES");
+                const char * id = getenv("GGML_VK_MMID_SIZES");
+                mm = mm ? mm : "m";
+                id = id ? id : mm;
+                device->mul_mat_l[i] = strchr(mm, 'l') != nullptr;
+                device->mul_mat_m[i] = strchr(mm, 'm') != nullptr;
+                device->mul_mat_s[i] = strchr(mm, 's') != nullptr;
+                device->mul_mat_id_l[i] = strchr(id, 'l') != nullptr;
+                device->mul_mat_id_m[i] = strchr(id, 'm') != nullptr;
+                device->mul_mat_id_s[i] = strchr(id, 's') != nullptr;
             }
 #endif
 
