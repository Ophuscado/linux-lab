+		msi-parent = <&DIE_NODE(usb4_3_pcie)>;
+		msi-ranges = <&aic AIC_IRQ DIE_NO 1929 IRQ_TYPE_EDGE_RISING 32>;
+
+		/* Fixed, so that the internal controllers keep the lowest domains */
+		linux,pci-domain = <(11 + 4 * DIE_NO)>;
+
+		/* Every device behind the tunnel shares one stream of the IOMMU */
+		iommu-map = <0x0 &DIE_NODE(usb4_3_pcie_dart) 1 1>;
+		iommu-map-mask = <0x0>;
+
+		bus-range = <0x00 0x3f>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		/* The 64-bit window is not translated, so its bus address depends on the die */
+		ranges = <0x43000000 (0x14 + 0x20 * DIE_NO) 0x00000000
+				0x14 0x00000000 0x2 0x00000000>,
+			<0x02000000 0x0 0x00100000 0x16 0x00100000 0x0 0x3ff00000>,
+			<0x42000000 0x0 0x40000000 0x16 0x40000000 0x0 0x40000000>;
+
+		/* ps_atc3_usb_aon, which macOS lists as well, is always on */
+		power-domains = <&DIE_NODE(ps_atc3_pcie)>;
+		resets = <&DIE_NODE(ps_atc3_pcie)>;
+
+		dma-coherent;
+		status = "disabled";
+
+		DIE_NODE(usb4_3_pcie_port): pci@0,0 {
+			device_type = "pci";
+			reg = <0x0 0x0 0x0 0x0 0x0>;
+
+			#address-cells = <3>;
+			#size-cells = <2>;
+			ranges;
+
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			#clock-cells = <0>;
+
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &DIE_NODE(usb4_3_pcie_port) 0 0 0 0>,
+					<0 0 0 2 &DIE_NODE(usb4_3_pcie_port) 0 0 0 1>,
+					<0 0 0 3 &DIE_NODE(usb4_3_pcie_port) 0 0 0 2>,
+					<0 0 0 4 &DIE_NODE(usb4_3_pcie_port) 0 0 0 3>;
+		};
+	};
 };
