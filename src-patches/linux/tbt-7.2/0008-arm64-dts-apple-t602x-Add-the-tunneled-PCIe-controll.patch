+&usb4_0_pcie_dart {
+	status = "okay";
+};
+
+&usb4_0_pcie {
+	status = "okay";
+};
+
+&usb4_1_pcie_dart {
+	status = "okay";
+};
+
+&usb4_1_pcie {
+	status = "okay";
+};
+
+&usb4_2_pcie_dart {
+	status = "okay";
+};
+
+&usb4_2_pcie {
+	status = "okay";
+};
+
+&usb4_3_pcie_dart {
+	status = "okay";
+};
+
