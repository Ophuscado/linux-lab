From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Wed, 4 Nov 2026 08:30:03 +0000
Subject: [PATCH 8/8] arm64: dts: apple: t602x: Add the tunneled PCIe
 controllers

Asahi's 7.2 trees have the M2 Pro/Max/Ultra USB4 host routers; this adds
what tunnels PCIe through them, as the 7.1 form of this change did: per
router a PCIe controller behind its PCIe adapter and that controller's
DART (one stream for every device behind the tunnel), the adapter's
registers on the router node and a phandle to the controller's port.

On the Mac Studio (M2 Ultra) all six ports get their controller: the
four rear ones on die 0 and the two front ones on die 1, whose unused
third and fourth routers are deleted. The rear ports' USB4 wiring (the
Type-C connectors to the routers), which this tree does not have yet,
comes with it.
---
 arch/arm64/boot/dts/apple/t6022-j475d.dts     |  69 ++++
 arch/arm64/boot/dts/apple/t602x-dieX.dtsi     | 352 +++++++++++++++++-
 .../arm64/boot/dts/apple/t602x-j474-j475.dtsi | 130 +++++++
 3 files changed, 543 insertions(+), 8 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6022-j475d.dts b/arch/arm64/boot/dts/apple/t6022-j475d.dts
index 6c09afcff..54f8d1886 100644
--- a/arch/arm64/boot/dts/apple/t6022-j475d.dts
+++ b/arch/arm64/boot/dts/apple/t6022-j475d.dts
@@ -34,6 +34,20 @@ aliases {
 		usb4_4_nhi = &usb4_0_nhi_die1;
 		usb4_5_rc = &usb4_1_acio_die1;
 		usb4_5_nhi = &usb4_1_nhi_die1;
+
+		/* Where the bootloader puts the tunables for PCIe tunneling */
+		usb4_0_pcie = &usb4_0_pcie;
+		usb4_0_pcie_adapter = &usb4_0_acio;
+		usb4_1_pcie = &usb4_1_pcie;
+		usb4_1_pcie_adapter = &usb4_1_acio;
+		usb4_2_pcie = &usb4_2_pcie;
+		usb4_2_pcie_adapter = &usb4_2_acio;
+		usb4_3_pcie = &usb4_3_pcie;
+		usb4_3_pcie_adapter = &usb4_3_acio;
+		usb4_4_pcie = &usb4_0_pcie_die1;
+		usb4_4_pcie_adapter = &usb4_0_acio_die1;
+		usb4_5_pcie = &usb4_1_pcie_die1;
+		usb4_5_pcie_adapter = &usb4_1_acio_die1;
 	};
 };
 
@@ -89,6 +103,61 @@ &typec5 {
 /delete-node/ &usb4_3_acio_die1;
 /delete-node/ &usb4_3_mbox_die1;
 
+/delete-node/ &usb4_2_pcie_die1;
+/delete-node/ &usb4_2_pcie_dart_die1;
+
+/delete-node/ &usb4_3_pcie_die1;
+/delete-node/ &usb4_3_pcie_dart_die1;
+
