+	 */
+	DIE_NODE(usb4_0_pcie_dart): iommu@721008000 {
+		compatible = "apple,t6020-dart", "apple,t8110-dart";
+		reg = <0x7 0x21008000 0x0 0x4000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ DIE_NO 1265 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&DIE_NODE(ps_atc0_pcie)>;
+		clocks = <&DIE_NODE(usb4_0_pcie_port)>;
+		/*
