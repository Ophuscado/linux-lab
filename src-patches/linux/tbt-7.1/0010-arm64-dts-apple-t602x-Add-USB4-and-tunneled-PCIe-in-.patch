+		compatible = "apple,t6020-dart", "apple,t8110-dart";
+		reg = <0x7 0x21008000 0x0 0x4000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ DIE_NO 1265 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&DIE_NODE(ps_atc0_pcie)>;
+		clocks = <&DIE_NODE(usb4_0_pcie_port)>;
+		/*
+		 * The port passes 32-bit addresses on and adds 0x100_00000000
+		 * to them (macOS: vm-base 0x100_80000000).
+		 */
+		apple,dma-range = <0x0 0x0 0x1 0x0>;
+		apple,dma-offset = /bits/ 64 <0x10000000000>;
+		status = "disabled";
+	};
+
+	DIE_NODE(usb4_0_pcie): pcie@730000000 {
+		compatible = "apple,t6020-usb4-pcie", "apple,t8103-usb4-pcie";
+		device_type = "pci";
+
+		reg = <0x7 0x30000000 0x0 0x4000000>,	/* config */
+			<0x7 0x20000000 0x0 0x8000>,	/* rc and fabric */
+			<0x7 0x21000000 0x0 0x8000>,	/* port0 */
+			<0x7 0x20200000 0x0 0x4000>;	/* debug */
+		reg-names = "config", "rc", "port0", "debug";
+
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ DIE_NO 1264 IRQ_TYPE_LEVEL_HIGH>;
+
+		msi-controller;
+		msi-parent = <&DIE_NODE(usb4_0_pcie)>;
+		msi-ranges = <&aic AIC_IRQ DIE_NO 1833 IRQ_TYPE_EDGE_RISING 32>;
+
+		/* Fixed, so that the internal controllers keep the lowest domains */
+		linux,pci-domain = <(8 + 4 * DIE_NO)>;
+
+		/* Every device behind the tunnel shares one stream of the IOMMU */
+		iommu-map = <0x0 &DIE_NODE(usb4_0_pcie_dart) 1 1>;
+		iommu-map-mask = <0x0>;
+
+		bus-range = <0x00 0x3f>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		/* The 64-bit window is not translated, so its bus address depends on the die */
+		ranges = <0x43000000 (0x8 + 0x20 * DIE_NO) 0x00000000
+				0x8 0x00000000 0x2 0x00000000>,
