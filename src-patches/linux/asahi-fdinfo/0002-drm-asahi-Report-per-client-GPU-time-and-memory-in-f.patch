diff --git a/drivers/gpu/drm/asahi/queue/compute.rs b/drivers/gpu/drm/asahi/queue/compute.rs
index 62afc56..0684c8a 100644
--- a/drivers/gpu/drm/asahi/queue/compute.rs
+++ b/drivers/gpu/drm/asahi/queue/compute.rs
@@ -112,6 +112,9 @@ pub(super) fn submit_compute(
             kalloc.shared.new_default::<fw::job::JobTimestamps>()?,
             GFP_KERNEL,
         )?;
+        // Read back when the command completes, for the client's fdinfo.
+        let done_ts = timestamps.clone();
+        let stats = self.stats.clone();
 
         let uuid = 0;
         mod_dev_dbg!(self.dev, "[Submission {}] UUID = {:#x?}\n", id, uuid);
@@ -375,6 +378,11 @@ pub(super) fn submit_compute(
                 fence.set_error(err.into())
             }
 
+            let (start, end) = done_ts.with(|raw, _| {
+                (raw.start.load(Ordering::Relaxed), raw.end.load(Ordering::Relaxed))
+            });
+            file::ClientStats::add(&stats.compute_ns, start, end);
+
             fence.command_complete();
         })?;
 
