 arch/arm64/boot/dts/apple/t6022-j475d.dts |  69 +++++
 arch/arm64/boot/dts/apple/t602x-dieX.dtsi | 328 +++++++++++++++++++++-
 2 files changed, 389 insertions(+), 8 deletions(-)

