 #include "agx_compiler.h"
 #include "agx_opcodes.h"
+#include "shader_enums.h"
+
+#define AGX_CORE_SHARED_BYTES 65536
 
 struct sched_ctx {
    /* Dependency graph */
@@ -17,6 +21,9 @@ struct sched_ctx {
 
    /* Live set */
    struct u_sparse_bitset live;
+
+   bool cluster;
+   signed budget;
 };
 
 struct sched_node {
@@ -198,7 +205,8 @@ choose_instr(struct sched_ctx *s)
 }
 
 static void
-pressure_schedule_block(agx_context *ctx, agx_block *block, struct sched_ctx *s)
+pressure_schedule_block(agx_context *ctx, agx_block *block, struct sched_ctx *s,
+                        signed headroom)
 {
    /* off by a constant, that's ok */
    signed pressure = 0;
@@ -216,6 +224,8 @@ pressure_schedule_block(agx_context *ctx, agx_block *block, struct sched_ctx *s)
 
    u_sparse_bitset_dup(&s->live, &block->live_out);
 
+   s->budget = orig_max_pressure + headroom;
+
    /* off by a constant, that's ok */
    signed max_pressure = 0;
    pressure = 0;
@@ -234,7 +244,8 @@ pressure_schedule_block(agx_context *ctx, agx_block *block, struct sched_ctx *s)
    }
 
    /* Bail if it looks like it's worse */
-   if (max_pressure >= orig_max_pressure) {
+   signed limit = s->cluster ? s->budget : orig_max_pressure;
+   if (s->cluster ? (max_pressure > limit) : (max_pressure >= limit)) {
       free(schedule);
       return;
    }
@@ -248,17 +259,63 @@ pressure_schedule_block(agx_context *ctx, agx_block *block, struct sched_ctx *s)
    free(schedule);
 }
 
+static signed
+cluster_headroom(agx_context *ctx)
+{
+   if (getenv("AGX_CLUSTER_OFF") || !mesa_shader_stage_is_compute(ctx->stage))
+      return 0;
+
+   bool has_local_load = false;
+   agx_foreach_instr_global(ctx, I) {
+      if (I->op == AGX_OPCODE_LOCAL_LOAD) {
+         has_local_load = true;
+         break;
+      }
+   }
+   if (!has_local_load)
+      return 0;
+
+   const char *env = getenv("AGX_CLUSTER_SLACK");
+   if (env)
+      return atoi(env);
+
+   unsigned threads_per_wg =
+      ctx->nir->info.workgroup_size_variable
+         ? 1024
+         : ctx->nir->info.workgroup_size[0] * ctx->nir->info.workgroup_size[1] *
+              ctx->nir->info.workgroup_size[2];
+
+   unsigned demand = agx_calc_register_demand(ctx, false);
+
+   if (demand >= agx_max_registers_for_occupancy(threads_per_wg))
+      return 0;
+
+   unsigned reg_wgs =
+      agx_occupancy_for_register_count(demand).max_threads / threads_per_wg;
+   unsigned shmem_wgs = ctx->nir->info.shared_size
+                           ? AGX_CORE_SHARED_BYTES / ctx->nir->info.shared_size
+                           : reg_wgs;
+   unsigned wgs = MIN2(reg_wgs, shmem_wgs);
+
+   signed ceiling = agx_max_registers_for_occupancy(wgs * threads_per_wg);
+   return ceiling - (signed)demand;
+}
+
 void
 agx_pressure_schedule(agx_context *ctx)
 {
    agx_compute_liveness(ctx);
    void *memctx = ralloc_context(ctx);
 
+   signed headroom = cluster_headroom(ctx);
+   bool cluster = headroom > 0;
+
    agx_foreach_block(ctx, block) {
-      struct sched_ctx sctx = {.dag = create_dag(ctx, block, memctx)};
+      struct sched_ctx sctx = {.dag = create_dag(ctx, block, memctx),
+                               .cluster = cluster};
       u_sparse_bitset_init(&sctx.live, ctx->alloc, memctx);
 
-      pressure_schedule_block(ctx, block, &sctx);
+      pressure_schedule_block(ctx, block, &sctx, headroom);
    }
 
    /* Clean up after liveness analysis */
