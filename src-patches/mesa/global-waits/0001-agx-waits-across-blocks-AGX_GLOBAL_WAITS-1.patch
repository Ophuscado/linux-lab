From 2be65b127d13f3d9b1dfa489f1e6deaa330b73c6 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Sun, 1 Nov 2026 03:44:30 +0000
Subject: [PATCH] agx: waits across blocks (AGX_GLOBAL_WAITS=1)

The wait pass waits for every pending load at the end of each block, so a loop cannot load its next iteration's data while it computes the current one. With AGX_GLOBAL_WAITS=1 the pending state flows into the blocks that can run next (control flow successors, and the next block in program order for divergent code) and each load is waited on before its first use.
---
 src/asahi/compiler/agx_insert_waits.c | 126 ++++++++++++++++++++++++--
 1 file changed, 116 insertions(+), 10 deletions(-)

diff --git a/src/asahi/compiler/agx_insert_waits.c b/src/asahi/compiler/agx_insert_waits.c
index 75bfd00..dc55043 100644
--- a/src/asahi/compiler/agx_insert_waits.c
+++ b/src/asahi/compiler/agx_insert_waits.c
@@ -3,6 +3,8 @@
  * SPDX-License-Identifier: MIT
  */
 
+#include <stdlib.h>
+#include <string.h>
 #include "agx_builder.h"
 #include "agx_compiler.h"
 #include "agx_debug.h"
@@ -50,11 +52,17 @@ agx_insert_waits_trivial(agx_context *ctx, agx_block *block)
  *
  * XXX: Do any instructions read their sources asynchronously?
  */
+#define AGX_NR_SLOTS (2)
+
+/*
+ * Assign slots and find the waits in one block, starting from the pending
+ * state in slots and leaving the state at the end of the block there. Only
+ * with emit are the waits inserted.
+ */
 static void
-agx_insert_waits_local(agx_context *ctx, agx_block *block)
+agx_insert_waits_block(agx_context *ctx, agx_block *block,
+                       struct slot *slots, bool emit)
 {
-   struct slot slots[2] = {0};
-
    agx_foreach_instr_in_block_safe(block, I) {
       uint8_t wait_mask = 0;
 
@@ -64,7 +72,7 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
             continue;
 
          unsigned nr_read = agx_index_size_16(I->src[s]);
-         for (unsigned slot = 0; slot < ARRAY_SIZE(slots); ++slot) {
+         for (unsigned slot = 0; slot < AGX_NR_SLOTS; ++slot) {
             if (BITSET_TEST_COUNT(slots[slot].writes, I->src[s].value, nr_read))
                wait_mask |= BITSET_BIT(slot);
          }
@@ -76,7 +84,7 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
             continue;
 
          unsigned nr_writes = agx_index_size_16(I->dest[d]);
-         for (unsigned slot = 0; slot < ARRAY_SIZE(slots); ++slot) {
+         for (unsigned slot = 0; slot < AGX_NR_SLOTS; ++slot) {
             if (BITSET_TEST_COUNT(slots[slot].writes, I->dest[d].value,
                                   nr_writes))
                wait_mask |= BITSET_BIT(slot);
@@ -87,7 +95,7 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
       if (I->op == AGX_OPCODE_THREADGROUP_BARRIER ||
           I->op == AGX_OPCODE_MEMORY_BARRIER) {
 
-         for (unsigned slot = 0; slot < ARRAY_SIZE(slots); ++slot) {
+         for (unsigned slot = 0; slot < AGX_NR_SLOTS; ++slot) {
             if (slots[slot].nr_pending)
                wait_mask |= BITSET_BIT(slot);
          }
@@ -95,7 +103,7 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
 
       /* Try to assign a free slot */
       if (instr_is_async(I)) {
-         for (unsigned slot = 0; slot < ARRAY_SIZE(slots); ++slot) {
+         for (unsigned slot = 0; slot < AGX_NR_SLOTS; ++slot) {
             if (slots[slot].nr_pending == 0) {
                I->scoreboard = slot;
                break;
@@ -110,8 +118,10 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
 
       /* Insert the appropriate waits, clearing the slots */
       u_foreach_bit(slot, wait_mask) {
-         agx_builder b = agx_init_builder(ctx, agx_before_instr(I));
-         agx_wait(&b, slot);
+         if (emit) {
+            agx_builder b = agx_init_builder(ctx, agx_before_instr(I));
+            agx_wait(&b, slot);
+         }
 
          BITSET_ZERO(slots[slot].writes);
          slots[slot].nr_pending = 0;
@@ -131,6 +141,19 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
          slots[I->scoreboard].nr_pending++;
       }
    }
+}
+
+/*
+ * Insert waits within a block, assuming scoreboard slots have already been
+ * assigned. This waits for everything at the end of the block, rather than
+ * doing something more intelligent/global.
+ */
+static void
+agx_insert_waits_local(agx_context *ctx, agx_block *block)
+{
+   struct slot slots[AGX_NR_SLOTS] = {0};
+
+   agx_insert_waits_block(ctx, block, slots, true);
 
    /* If there are outstanding messages, wait for them. We don't do this for the
     * exit block, though, since nothing else will execute in the shader so
@@ -139,13 +162,92 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
    if (block != agx_exit_block(ctx)) {
       agx_builder b = agx_init_builder(ctx, agx_after_block_logical(block));
 
-      for (unsigned slot = 0; slot < ARRAY_SIZE(slots); ++slot) {
+      for (unsigned slot = 0; slot < AGX_NR_SLOTS; ++slot) {
          if (slots[slot].nr_pending)
             agx_wait(&b, slot);
       }
    }
 }
 
+/*
+ * Waits across blocks: the pending messages at the end of a block carry into
+ * the blocks that can run after it, so a load can be waited on where its
+ * result is first used rather than at the end of its block, as a loop that
+ * loads the next iteration's data needs. A block can run after its control
+ * flow predecessors and, as divergent code runs both sides of an if in order
+ * under the execution mask, after the block before it in program order. The
+ * state entering a block is the union of those (registers written, the most
+ * messages pending), found by iterating to a fixed point; if that does not
+ * settle, the local pass is used.
+ */
+static void
+merge_slots(struct slot *merged, const struct slot *from)
+{
+   for (unsigned i = 0; i < AGX_NR_SLOTS; ++i) {
+      BITSET_OR(merged[i].writes, merged[i].writes, from[i].writes);
+      merged[i].nr_pending = MAX2(merged[i].nr_pending, from[i].nr_pending);
+   }
+}
+
+static bool
+agx_insert_waits_global(agx_context *ctx)
+{
+   unsigned nr_blocks = 0;
+   agx_foreach_block(ctx, block)
+      nr_blocks = MAX2(nr_blocks, block->index + 1);
+
+   struct slot *in = calloc(nr_blocks * AGX_NR_SLOTS, sizeof(struct slot));
+   struct slot *out = calloc(nr_blocks * AGX_NR_SLOTS, sizeof(struct slot));
+   bool settled = false;
+
+   for (unsigned iter = 0; iter < 32 && !settled; ++iter) {
+      settled = true;
+
+      agx_block *prev = NULL;
+
+      agx_foreach_block(ctx, block) {
+         struct slot merged[AGX_NR_SLOTS];
+         memset(merged, 0, sizeof(merged));
+
+         agx_foreach_predecessor(block, pred) {
+            merge_slots(merged, &out[(*pred)->index * AGX_NR_SLOTS]);
+         }
+
+         if (prev)
+            merge_slots(merged, &out[prev->index * AGX_NR_SLOTS]);
+
+         prev = block;
+
+         struct slot *bin = &in[block->index * AGX_NR_SLOTS];
+         if (memcmp(bin, merged, sizeof(merged)) != 0 || iter == 0) {
+            memcpy(bin, merged, sizeof(merged));
+
+            struct slot state[AGX_NR_SLOTS];
+            memcpy(state, merged, sizeof(state));
+            agx_insert_waits_block(ctx, block, state, false);
+
+            struct slot *bout = &out[block->index * AGX_NR_SLOTS];
+            if (memcmp(bout, state, sizeof(state)) != 0) {
+               memcpy(bout, state, sizeof(state));
+               settled = false;
+            }
+         }
+      }
+   }
+
+   if (settled) {
+      agx_foreach_block(ctx, block) {
+         struct slot state[AGX_NR_SLOTS];
+         memcpy(state, &in[block->index * AGX_NR_SLOTS], sizeof(state));
+         agx_insert_waits_block(ctx, block, state, true);
+      }
+   }
+
+   free(in);
+   free(out);
+   return settled;
+}
+
 /*
  * Assign scoreboard slots to asynchronous instructions and insert waits for the
  * appropriate hazard tracking.
@@ -153,6 +255,10 @@ agx_insert_waits_local(agx_context *ctx, agx_block *block)
 void
 agx_insert_waits(agx_context *ctx)
 {
+   if (!(agx_compiler_debug & AGX_DBG_WAIT) && getenv("AGX_GLOBAL_WAITS") &&
+       agx_insert_waits_global(ctx))
+      return;
+
    agx_foreach_block(ctx, block) {
       if (agx_compiler_debug & AGX_DBG_WAIT)
          agx_insert_waits_trivial(ctx, block);
-- 
2.43.0

