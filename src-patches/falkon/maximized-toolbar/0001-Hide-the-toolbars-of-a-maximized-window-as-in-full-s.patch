From cea425894de6b2f542fe0e7ed55b8b97225526a3 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Sat, 31 Oct 2026 22:20:13 +0000
Subject: [PATCH] Hide the toolbars of a maximized window as in full screen

An opt-in setting, Browser-View-Settings/AutoHideToolbarsMaximized (default off): a maximized window hides its navigation toolbars as a full-screen one does and shows them while the pointer is at the top of the page. No settings page entry yet.
---
 src/lib/app/browserwindow.cpp    | 16 +++++++++++++---
 src/lib/app/browserwindow.h      |  1 +
 src/lib/other/qzsettings.cpp     |  1 +
 src/lib/other/qzsettings.h       |  2 ++
 src/lib/webtab/tabbedwebview.cpp |  2 +-
 5 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/src/lib/app/browserwindow.cpp b/src/lib/app/browserwindow.cpp
index a4a612f..10bddd4 100644
--- a/src/lib/app/browserwindow.cpp
+++ b/src/lib/app/browserwindow.cpp
@@ -1162,7 +1162,7 @@ void BrowserWindow::addTab()
     m_tabWidget->addView(QUrl(), Qz::NT_SelectedNewEmptyTab, true);
     m_tabWidget->setCurrentTabFresh(true);
 
-    if (isFullScreen())
+    if (autoHidesNavigation())
         showNavigationWithFullScreen();
 }
 
@@ -1200,7 +1200,7 @@ void BrowserWindow::openFile()
 
 void BrowserWindow::openLocation()
 {
-    if (isFullScreen()) {
+    if (autoHidesNavigation()) {
         showNavigationWithFullScreen();
     }
 
@@ -1213,6 +1213,11 @@ bool BrowserWindow::fullScreenNavigationVisible() const
     return m_navigationContainer->isVisible();
 }
 
+bool BrowserWindow::autoHidesNavigation() const
+{
+    return isFullScreen() || (isMaximized() && qzSettings->autoHideToolbarsMaximized);
+}
+
 void BrowserWindow::showNavigationWithFullScreen()
 {
     if (m_htmlFullScreenView)
@@ -1240,7 +1245,7 @@ void BrowserWindow::hideNavigationSlot()
     TabbedWebView* view = weView();
     bool mouseInView = view && view->underMouse();
 
-    if (isFullScreen() && mouseInView) {
+    if (autoHidesNavigation() && mouseInView) {
         m_navigationContainer->hide();
     }
 }
@@ -1280,6 +1285,11 @@ bool BrowserWindow::event(QEvent *event)
         if (m_hideNavigationTimer) {
             m_hideNavigationTimer->stop();
         }
+
+        // A maximized window hides its toolbars as in full screen; any other state shows them
+        if (qzSettings->autoHideToolbarsMaximized && !isFullScreen()) {
+            m_navigationContainer->setVisible(!isMaximized());
+        }
     }
 
     return QMainWindow::event(event);
diff --git a/src/lib/app/browserwindow.h b/src/lib/app/browserwindow.h
index 0fc7d29..1bb73cb 100644
--- a/src/lib/app/browserwindow.h
+++ b/src/lib/app/browserwindow.h
@@ -86,6 +86,7 @@ public:
     void restoreWindow(const SavedWindow &window);
 
     bool fullScreenNavigationVisible() const;
+    bool autoHidesNavigation() const;
     void showNavigationWithFullScreen();
     void hideNavigationWithFullScreen();
 
diff --git a/src/lib/other/qzsettings.cpp b/src/lib/other/qzsettings.cpp
index a2b98ca..86b2887 100644
--- a/src/lib/other/qzsettings.cpp
+++ b/src/lib/other/qzsettings.cpp
@@ -72,6 +72,7 @@ void QzSettings::loadSettings()
     backgroundColorLoaded = settings.value(QSL("BackgroundColorLoaded"), QColor(Qt::white)).value<QColor>();
     loadedSwitchDelay = settings.value(QSL("LoadedSwitchDelay"), 250).toInt();
     defaultSideBarWidth = settings.value(QSL("DefaultSideBarWidth"), 200).toInt();
+    autoHideToolbarsMaximized = settings.value(QSL("AutoHideToolbarsMaximized"), false).toBool();
     settings.endGroup();
 }
 
diff --git a/src/lib/other/qzsettings.h b/src/lib/other/qzsettings.h
index e40e504..2adf059 100644
--- a/src/lib/other/qzsettings.h
+++ b/src/lib/other/qzsettings.h
@@ -73,6 +73,8 @@ public:
     int loadedSwitchDelay;
 
     int defaultSideBarWidth;
+    // Hide the toolbars of a maximized window as in full screen, until the pointer reaches the top
+    bool autoHideToolbarsMaximized;
 };
 
 #define qzSettings Settings::staticSettings()
diff --git a/src/lib/webtab/tabbedwebview.cpp b/src/lib/webtab/tabbedwebview.cpp
index 179ad62..5edf855 100644
--- a/src/lib/webtab/tabbedwebview.cpp
+++ b/src/lib/webtab/tabbedwebview.cpp
@@ -208,7 +208,7 @@ void TabbedWebView::_contextMenuEvent(QContextMenuEvent *event)
 
 void TabbedWebView::_mouseMoveEvent(QMouseEvent *event)
 {
-    if (m_window && m_window->isFullScreen()) {
+    if (m_window && m_window->autoHidesNavigation()) {
         if (m_window->fullScreenNavigationVisible()) {
             m_window->hideNavigationWithFullScreen();
         }
-- 
