From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Sun, 1 Nov 2026 03:35:38 +0000
Subject: [PATCH] vulkan: gated delta net buffers restrict

---
 .../vulkan-shaders/gated_delta_net.comp            | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
index cb9a7352e..1cb733553 100644
--- a/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/gated_delta_net.comp
@@ -34,13 +34,13 @@ layout(push_constant) uniform Parameters {
     uint K;
 };
 
-layout(binding = 0) readonly  buffer QBuf     { FLOAT_TYPE data_q[];     };
-layout(binding = 1) readonly  buffer KBuf     { FLOAT_TYPE data_k[];     };
-layout(binding = 2) readonly  buffer VBuf     { FLOAT_TYPE data_v[];     };
-layout(binding = 3) readonly  buffer GBuf     { FLOAT_TYPE data_g[];     };
-layout(binding = 4) readonly  buffer BetaBuf  { FLOAT_TYPE data_beta[];  };
-layout(binding = 5) readonly  buffer StateBuf { FLOAT_TYPE data_state[]; };
-layout(binding = 6)           buffer DstBuf   { FLOAT_TYPE data_dst[];   };
+layout(binding = 0) readonly restrict buffer QBuf     { FLOAT_TYPE data_q[];     };
+layout(binding = 1) readonly restrict buffer KBuf     { FLOAT_TYPE data_k[];     };
+layout(binding = 2) readonly restrict buffer VBuf     { FLOAT_TYPE data_v[];     };
+layout(binding = 3) readonly restrict buffer GBuf     { FLOAT_TYPE data_g[];     };
+layout(binding = 4) readonly restrict buffer BetaBuf  { FLOAT_TYPE data_beta[];  };
+layout(binding = 5) readonly restrict buffer StateBuf { FLOAT_TYPE data_state[]; };
+layout(binding = 6) restrict          buffer DstBuf   { FLOAT_TYPE data_dst[];   };
 
 #if !USE_SUBGROUP_ADD && !USE_SUBGROUP_CLUSTERED
 shared FLOAT_TYPE temp[SUBGROUP_SIZE];
-- 
