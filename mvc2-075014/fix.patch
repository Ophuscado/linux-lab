From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ophuscado <postbox@ophuscado.com>
Date: Sun, 1 Nov 2026 05:33:15 +0000
Subject: [PATCH 16/16] vulkan: Metal-layout matrix-vector decodes A once for
 all columns

Its loop loaded and decoded each row's slice of A once per column of B, so GGML_VK_MMV_SIMD kept it to one column. A is now decoded once per block and applied to every column; GGML_VK_MMV_SIMD=2 uses it for every column count.
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp          | 12 ++--
 .../vulkan-shaders/mul_mat_vec_simd.comp      | 61 +++++++++++++------
 2 files changed, 50 insertions(+), 23 deletions(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 32792021d..fe5a5836b 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -2990,9 +2990,11 @@ void ggml_vk_load_shaders(vk_device& device, vk_pipeline requested) {
     // GGML_VK_MMV_SIMD=1: q4_0 and q8_0 matrix-vector through mul_mat_vec_simd.comp, ggml-metal's layout, for one
     // column only (and MUL_MAT_ID): it reloads B per column, so batches of 2-16 columns stay on mul_mat_vec.comp, which
     // was 2-4x faster there (Llama 2 Q4_0 at 8-12 tokens: 41-19 t/s with it, 170 without).
+    // GGML_VK_MMV_SIMD=2: the same shader for every column count, now that it decodes A once for all columns.
     const bool mmv_simd = getenv("GGML_VK_MMV_SIMD") != nullptr && atoi(getenv("GGML_VK_MMV_SIMD")) != 0;
+    const bool mmv_simd_cols = mmv_simd && atoi(getenv("GGML_VK_MMV_SIMD")) >= 2;
     if (mmv_simd) {
-        fprintf(stderr, "ggml_vulkan: q4_0 and q8_0 matrix-vector: mul_mat_vec_simd\n");
+        fprintf(stderr, "ggml_vulkan: q4_0 and q8_0 matrix-vector: mul_mat_vec_simd%s\n", mmv_simd_cols ? ", every column count" : "");
     }
     // The Imagination proprietary compiler rejects the subgroup-only dequant mul_mat_vec
     // shaders that require a subgroup size >= 16; fall back to shared-memory reduction.
